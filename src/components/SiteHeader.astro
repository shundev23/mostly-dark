---
import { SECTIONS } from "../site";
import { withBase, currentState } from "../lib/paths";

const pathname = Astro.url.pathname;
const isHome = pathname === withBase("");
---

<header class="site-header">
  <div class="container inner">
    <a class="brand" href={withBase("")} aria-current={isHome ? "page" : undefined}>
      <img class="mark" src={withBase("favicon.svg")} alt="" width="22" height="22" />
      <span class="name"><span class="hobo">ほぼ</span>ダーク</span>
    </a>
    <nav aria-label="サイト内">
      <ul class="nav">
        {
          SECTIONS.map((s) => (
            <li>
              <a href={withBase(s.path)} aria-current={currentState(pathname, s.path)} style={`--c: var(--c-${s.key})`}>
                {s.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { border-bottom: 1px solid var(--line); }
  .inner { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 60px; }

  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; }
  .mark { flex: none; }
  .name { font: 700 18px/1 var(--font-display); letter-spacing: .06em; }
  .hobo { color: var(--text-2); font-size: .82em; margin-right: .06em; }

  .nav { display: flex; gap: 4px; margin: 0; padding: 0; list-style: none; }
  .nav a {
    position: relative; display: block; padding: 8px 10px; border-radius: 8px;
    color: var(--text-2); font-size: 14.5px; font-weight: 500; line-height: 1.4; text-decoration: none;
  }
  .nav a:hover { color: var(--text); background: var(--bg-2); }
  /* 今いる棚には、その棚の色の線を引く（素粒子の軌跡のイメージ） */
  .nav a[aria-current] { color: var(--text); }
  .nav a[aria-current]::after {
    content: ""; position: absolute; left: 10px; right: 10px; bottom: 2px; height: 2px; border-radius: 2px;
    background: var(--c);
  }
  @media (max-width: 380px) {
    .nav a { padding-inline: 7px; font-size: 14px; }
    .nav a[aria-current]::after { left: 7px; right: 7px; }
  }
</style>
