---
/**
 * 全ページ共通の枠（<head>・ヘッダー・フッター）。
 * 各ページは <BaseLayout title="作品" description="..."> で囲む。
 */
import "../styles/global.css";
import SiteHeader from "../components/SiteHeader.astro";
import SiteFooter from "../components/SiteFooter.astro";
import { SITE } from "../site";
import { withBase } from "../lib/paths";

interface Props {
  /** ページ名。トップページでは省略する（タイトルはサイト名だけになる） */
  title?: string;
  description?: string;
  /** 検索結果に出さないページ（404など）。canonical と og:url も出さない */
  noindex?: boolean;
}

const { title, description = SITE.description, noindex = false } = Astro.props;

const pageTitle = title ? `${title} | ${SITE.title}` : SITE.title;
// Astro.site は astro.config.mjs の site。未設定でもビルドが落ちないよう、そのときは相対URLのままにする
const canonicalUrl = noindex
  ? undefined
  : Astro.site
    ? new URL(Astro.url.pathname, Astro.site).href
    : Astro.url.pathname;

// 作品「素粒子の軌跡」と同じURLにして、ページ間を移動したときにブラウザのキャッシュを使い回す
const fontsHref =
  "https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500&family=IBM+Plex+Sans+JP:wght@400;500;700&family=STIX+Two+Text:ital,wght@0,400;0,600;1,400&family=Shippori+Mincho:wght@700&display=swap";
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#05070D" />
    <meta name="generator" content={Astro.generator} />
    {noindex && <meta name="robots" content="noindex" />}
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
    <link rel="icon" type="image/svg+xml" href={withBase("favicon.svg")} />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonicalUrl && <meta property="og:url" content={canonicalUrl} />}
    <meta name="twitter:card" content="summary" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href={fontsHref} />
  </head>
  <body>
    <a class="skip-link" href="#main">本文へ移動</a>
    <SiteHeader />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
