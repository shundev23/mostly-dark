---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import WorkCard from "../../components/WorkCard.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getSection } from "../../site";
import { getPublishedWorks } from "../../lib/works";

const section = getSection("works");
const works = await getPublishedWorks();
---

<BaseLayout title={section.label} description={section.description}>
  <div class="container">
    <PageHeader section={section} />
    {
      works.length > 0 ? (
        <ul class="grid">
          {works.map((work) => (
            <li>
              <WorkCard work={work} headingLevel={2} />
            </li>
          ))}
        </ul>
      ) : (
        <EmptyState>
          <p>作品を追加すると、ここに並ぶ。</p>
        </EmptyState>
      )
    }
  </div>
</BaseLayout>

<style>
  .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr)); gap: 16px; margin: 0; padding: 0; list-style: none; }
  .grid > li { display: grid; }
</style>
