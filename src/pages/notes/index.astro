---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHeader from "../../components/PageHeader.astro";
import EmptyState from "../../components/EmptyState.astro";
import { getSection } from "../../site";

// ノートは Step 2 で数式つきのコレクションにする。それまではこの予告だけを出す
const section = getSection("notes");
---

<BaseLayout title={section.label} description={section.description}>
  <div class="container">
    <PageHeader section={section} />
    <EmptyState>
      <p>最初のノートでは、円運動からケプラーの第3法則を導く予定。</p>
    </EmptyState>
  </div>
</BaseLayout>
